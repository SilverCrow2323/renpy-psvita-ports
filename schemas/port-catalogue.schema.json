{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spdwfactory.example/schemas/renpy-psvita-port-catalogue.schema.json",
  "title": "Ren'Py PSVita Port Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_id",
    "generated_at",
    "ports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalogue_id": {
      "const": "renpy-psvita-ports"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object"
      }
    }
  }
}
