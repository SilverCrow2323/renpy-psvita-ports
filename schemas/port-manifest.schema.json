{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spdwfactory.example/schemas/renpy-vita-port-manifest.schema.json",
  "title": "Ren'Py PSVita Port Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "port_id",
    "title",
    "repository",
    "platform",
    "engine",
    "status",
    "docs_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "port_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/SilverCrow2323/"
    },
    "platform": {
      "const": "psvita"
    },
    "engine": {
      "const": "renpy"
    },
    "status": {
      "enum": [
        "released",
        "experimental",
        "in-progress",
        "archived"
      ]
    },
    "title_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{9}$"
    },
    "game_data_path": {
      "type": "string",
      "pattern": "^ux0:/app/[A-Z0-9]{9}/$"
    },
    "original_game_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "upstream_repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "docs_path": {
      "type": "string",
      "pattern": "^docs/ports/[a-z0-9-]+/README\\.md$"
    },
    "notes": {
      "type": "string",
      "maxLength": 600
    }
  }
}
